<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="BMS Smoke Test Suite">
    <listeners>
        <listener class-name="listeners.ExtentReporterNG"/>
    </listeners>

    <test name="Smoke Tests" preserve-order="true">
        <classes>
            <class name="test.BMSTest">
                <methods>
                    <include name="verifyUrlTest"/>
                    <include name="verifyTitleTest"/>
                    <include name="verifyBrokenLinksTest"/>
                    <include name="verifyCheckNavigationFlow"/>
                    <include name="verifyLogin"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>